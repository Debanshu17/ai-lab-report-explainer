# LLM Provider Configuration (default: gemini; options: gemini, openai, anthropic)
LLM_PROVIDER=gemini

# API Keys (never commit actual keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Model Settings
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0

# Extraction & Explanation Modes
EXTRACTION_MODE=rules_plus_verified_llm
EXPLANATION_MODE=llm_grounded

# Chroma Vector Store
CHROMA_PERSIST_DIRECTORY=data/chroma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
